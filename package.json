{
  "name": "dev-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter pages dev",
    "deploy": "bun --filter pages deploy",
    "lint": "oxlint && oxfmt --check && bun --filter '*' lint",
    "format": "oxfmt",
    "check": "tsc",
    "test": "bun --filter '*' test",
    "test:update": "bun --filter '*' test:update"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markuplint": "^5.0.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
