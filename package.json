{
  "name": "dev-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter pages dev",
    "deploy": "bun --filter pages deploy",
    "lint": "oxlint && oxfmt --check && bun --filter '*' lint",
    "format": "oxfmt",
    "check": "tsc",
    "test": "bun --filter '*' test",
    "test:update": "bun --filter '*' test:update"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markuplint": "^5.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "resp-modifier": {
      "minimatch": "^3.1.5"
    }
  },
  "engines": {
    "bun": "^1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
